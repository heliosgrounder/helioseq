# The sdist must contain everything needed to rebuild the extension from
# scratch: the vendored C core, the binding, and the tests that prove the build
# works. uShuffle 1.x shipped C generated by Cython 0.29.5 instead, and that is
# exactly why its sdist stopped building on new Python versions.

include LICENSE
include CHANGELOG.md
include CITATION.cff
include README.md
include Makefile
recursive-include docs *.md

recursive-include src/libushuffle *.c *.h LICENSE.original
recursive-include src/helioseq *.c *.pyi py.typed

recursive-include tests *.py *.c *.json *.fa *.fastq
recursive-include benchmarks *.py
recursive-include .github *.yml
# Never ship built artefacts.
global-exclude *.so *.pyd *.py[cod] .DS_Store
prune **/__pycache__
prune build
prune dist
